# Copy this file to .env and fill it in. Never commit .env.

# --- AI model (any OpenAI-compatible endpoint) ---
# Free local option for development: Ollama (https://ollama.com), no key needed.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma4:e2b
LLM_API_KEY=
# Free hosted option: Cloudflare Workers AI (free daily allowance), for example
# LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
# LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# LLM_API_KEY=<a Workers AI API token>

# --- ShelterApp API ---
# Path to a ShelterApp listings export (JSON). Without it, the fake demo listings in data/ are used.
LISTINGS_PATH=
# If empty, Mandy uses resource-tool/audit_results/inventory_master.json when the resource tool has made one.
# Leave SHELTERAPP_API_URL empty to run in demo mode with the fake sample data in data/.
SHELTERAPP_API_URL=
# Token for a dedicated, NON-admin bot account, so everything it adds waits for approval.
SHELTERAPP_BOT_TOKEN=

PORT=8787
